{
  "name": "selectie-evaluatietool",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [8050],
  "portsAttributes": {
    "8050": {
      "label": "Dash app",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "uv sync",
  "remoteUser": "vscode",
  "containerEnv": {
    "CLAUDE_CODE_USE_FOUNDRY": "${localEnv:CLAUDE_CODE_USE_FOUNDRY}",
    "ANTHROPIC_FOUNDRY_API_KEY": "${localEnv:ANTHROPIC_FOUNDRY_API_KEY}",
    "ANTHROPIC_FOUNDRY_RESOURCE": "${localEnv:ANTHROPIC_FOUNDRY_RESOURCE}",
    "GH_TOKEN": "${localEnv:GITHUB_PAT}"
  },
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude/CLAUDE.md,target=/home/vscode/.claude/CLAUDE.md,type=bind,readonly",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude/RTK.md,target=/home/vscode/.claude/RTK.md,type=bind,readonly",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude/github-issue-workflow.md,target=/home/vscode/.claude/github-issue-workflow.md,type=bind,readonly",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude/rules,target=/home/vscode/.claude/rules,type=bind,readonly"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": ".venv/bin/python",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  }
}
